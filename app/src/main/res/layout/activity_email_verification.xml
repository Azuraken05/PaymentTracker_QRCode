<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emailVerificationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/form_max_width"
        app:cardBackgroundColor="@color/card_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/surface_variant">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="Verify Email"
                    android:src="@drawable/ic_mark_email_read"
                    app:tint="@color/brand_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Verify Your Email Address"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="We sent a verification link to:"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- User Email Pill -->
            <TextView
                android:id="@+id/tvVerificationEmailAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/surface_variant"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="officer@school.edu"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Click the link in your email to verify your account and access class fund workspaces. Check your spam folder if you do not see it."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Primary: I've Verified My Email -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifiedCheck"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/brand_primary"
                android:text="I've Verified My Email"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/white" />

            <!-- Secondary: Open Email App -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenEmailApp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Open Email App"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_mark_email_read"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <!-- Resend Link with countdown -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResendVerification"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Resend Verification Link"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                android:textSize="13sp" />

            <!-- Use Different Account / Sign Out -->
            <TextView
                android:id="@+id/tvSignOutOrDifferentAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp"
                android:text="Use a different account / Sign Out"
                android:textColor="@color/status_void_red"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
